NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://studentos:studentos@localhost:5432/studentos?schema=public
DATABASE_MODE=postgres
DATABASE_DIR=./packages/database/.local/studentos
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_MODE=development
ALLOW_DEV_AUTH=false
# Optional local preview role bootstrap; production configuration rejects these.
# DEV_CONTENT_EDITOR_EMAIL=preview-editor@example.com
# DEV_CONTENT_REVIEWER_EMAIL=preview-reviewer@example.com
PUBLIC_WEB_URL=http://localhost:3000
# Production email authentication requires both values and AUTH_MODE=email.
# EMAIL_GATEWAY_URL=https://transactional-email-gateway.example/v1/send
# EMAIL_GATEWAY_TOKEN=replace-with-secret-manager-value
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
# Set only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
AI_PROVIDER_NAME=configured-gateway
AI_MODEL=configured-model
# AI_GATEWAY_URL=https://internal-ai-gateway.example/v1/generate
# AI_GATEWAY_TOKEN=replace-with-secret-manager-value
NOTIFICATION_SWEEP_MS=60000
LIFECYCLE_SWEEP_MS=21600000
# EMAIL_GATEWAY_URL=https://internal-email-gateway.example/v1/send
# EMAIL_GATEWAY_TOKEN=replace-with-secret-manager-value
