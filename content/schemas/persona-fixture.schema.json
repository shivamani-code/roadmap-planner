{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentos.app/schemas/persona-fixture/1.0.0",
  "title": "StudentOS Roadmap Prototype Persona Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rulesetVersion", "personas"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "rulesetVersion": { "const": "prototype-1.0.0" },
    "personas": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/persona" }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "supportedCurriculum",
        "roleKey",
        "targetLevel",
        "deadlineWeeks",
        "normalWeeklyMinutes",
        "mode",
        "skills",
        "requirements",
        "expected"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "description": { "type": "string", "minLength": 10, "maxLength": 300 },
        "supportedCurriculum": { "type": "boolean" },
        "roleKey": { "$ref": "#/$defs/stableKey" },
        "targetLevel": {
          "type": "string",
          "enum": ["INTERNSHIP_READY", "SERVICE_PLACEMENT", "PRODUCT_PLACEMENT"]
        },
        "deadlineWeeks": { "type": "integer", "minimum": 1, "maximum": 260 },
        "normalWeeklyMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "mode": {
          "type": "string",
          "enum": [
            "NORMAL",
            "INTERNAL_EXAM",
            "SEMESTER_EXAM",
            "VACATION",
            "PLACEMENT"
          ]
        },
        "skills": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/studentSkill" }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirement" }
        },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "studentSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proficiency", "confidence"],
      "properties": {
        "proficiency": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "confidence": { "$ref": "#/$defs/ratio" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillKey",
        "requiredDepth",
        "importance",
        "placementRelevance",
        "prerequisites",
        "academicDepth",
        "mappingConfidence",
        "academicTiming",
        "estimatedMinutes",
        "required"
      ],
      "properties": {
        "skillKey": { "$ref": "#/$defs/stableKey" },
        "requiredDepth": { "$ref": "#/$defs/ratio" },
        "importance": { "$ref": "#/$defs/ratio" },
        "placementRelevance": { "$ref": "#/$defs/ratio" },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableKey" }
        },
        "academicDepth": { "$ref": "#/$defs/ratio" },
        "mappingConfidence": { "$ref": "#/$defs/ratio" },
        "academicTiming": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "CURRENT",
            "FUTURE_BEFORE_REQUIRED",
            "AFTER_REQUIRED",
            "NONE"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "required": { "type": "boolean" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "classifications",
        "maxWeeklyMinutes",
        "prerequisiteOrder"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["READY", "INFEASIBLE", "UNSUPPORTED"]
        },
        "classifications": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "MASTERED",
              "PARTIAL",
              "COLLEGE_CURRENT",
              "COLLEGE_FUTURE",
              "COLLEGE_EXTENSION",
              "INDEPENDENT",
              "DEFERRED",
              "NOT_REQUIRED",
              "UNKNOWN"
            ]
          }
        },
        "maxWeeklyMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "prerequisiteOrder": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableKey" }
        }
      }
    }
  }
}
