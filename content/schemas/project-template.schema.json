{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentos.app/schemas/project-template/1.0.0",
  "title": "StudentOS Project Template Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "synthetic", "projects"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "synthetic": { "type": "boolean" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "title",
        "goal",
        "roleKeys",
        "difficulty",
        "estimatedHours",
        "portfolioValue",
        "prerequisites",
        "deliverables",
        "deploymentRequired",
        "milestones"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/stableKey" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "goal": { "type": "string", "minLength": 20, "maxLength": 1000 },
        "roleKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableKey" }
        },
        "difficulty": {
          "type": "string",
          "enum": ["FOUNDATION", "INTERMEDIATE", "ADVANCED"]
        },
        "estimatedHours": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p25", "p50", "p75"],
          "properties": {
            "p25": { "type": "number", "minimum": 1 },
            "p50": { "type": "number", "minimum": 1 },
            "p75": { "type": "number", "minimum": 1 }
          }
        },
        "portfolioValue": { "$ref": "#/$defs/ratio" },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skillKey", "threshold", "type"],
            "properties": {
              "skillKey": { "$ref": "#/$defs/stableKey" },
              "threshold": { "$ref": "#/$defs/ratio" },
              "type": { "type": "string", "enum": ["HARD", "SOFT"] }
            }
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 300 }
        },
        "deploymentRequired": { "type": "boolean" },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/milestone" }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "sequence",
        "weight",
        "estimatedMinutes",
        "skillOutcomes",
        "completionCriteria"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/stableKey" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 12000
        },
        "skillOutcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableKey" }
        },
        "completionCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    }
  }
}
