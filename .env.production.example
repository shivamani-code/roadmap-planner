STUDENTOS_IMAGE_TAG=latest
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters-from-a-secret-manager

PUBLIC_WEB_URL=https://studentos.example.com
PUBLIC_ADMIN_URL=https://admin.studentos.example.com
PUBLIC_API_URL=https://api.studentos.example.com/api/v1
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

EMAIL_GATEWAY_URL=https://transactional-email-gateway.example/v1/send
EMAIL_GATEWAY_TOKEN=replace-with-a-secret-manager-token

# Optional bounded AI wording gateway. Configure both or neither.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
