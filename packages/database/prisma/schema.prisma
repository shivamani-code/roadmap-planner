generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum VerificationPurpose {
  SIGN_IN
  EMAIL_CHANGE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum ContentStatus {
  DRAFT
  VALIDATING
  IN_REVIEW
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum CoverageStatus {
  SUPPORTED
  PARTIAL
  UNSUPPORTED
}

enum SubjectType {
  THEORY
  LAB
  INTEGRATED
  PROJECT
  SEMINAR
  ELECTIVE
}

enum OnboardingStatus {
  ACADEMIC
  GOAL
  ASSESSMENT
  AVAILABILITY
  REVIEW
  COMPLETE
}

enum AdminRole {
  CONTENT_EDITOR
  CONTENT_REVIEWER
  SUPPORT
  ANALYST
  SUPER_ADMIN
}

enum SkillCategory {
  PROGRAMMING
  DSA
  CORE_CS
  DEVELOPMENT
  DATABASES
  TOOLS
  DATA
  PROJECTS
  APTITUDE
  COMMUNICATION
  RESUME
  INTERVIEW
}

enum PrerequisiteType {
  HARD
  SOFT
}

enum TargetLevel {
  INTERNSHIP_READY
  SERVICE_PLACEMENT
  PRODUCT_PLACEMENT
}

enum LearningUnitType {
  TEACH
  PRACTICE
  ASSESS
  REVISE
}

enum Difficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum CareerGoalStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum AssessmentStatus {
  OPEN
  SUBMITTED
  SCORED
}

enum EvidenceSource {
  SELF_REPORT
  COURSE_COMPLETION
  EXERCISE
  DIAGNOSTIC
  TASK_COMPLETION
  PROJECT_MILESTONE
  MOCK_INTERVIEW
}

enum GapClassification {
  MASTERED
  COLLEGE_COVERED
  EXTENSION
  INDEPENDENT
  CAREER_ONLY
  DEFERRED
  UNKNOWN
}

enum GapAnalysisStatus {
  READY
  INSUFFICIENT_CAPACITY
  UNSUPPORTED
}

enum RoadmapLifecycleStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum RoadmapRevisionStatus {
  DRAFT
  VALIDATING
  READY
  ACTIVE
  SUPERSEDED
  FAILED
}

enum RoadmapTrack {
  ACADEMIC
  CAREER
  PROJECT
  PLACEMENT
}

enum RoadmapMilestoneStatus {
  PLANNED
  LOCKED
  COMPLETED
  EXCLUDED
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum PlanningWeekStatus {
  ACTIVE
  LOCKED
  SUPERSEDED
}

enum TaskOccurrenceStatus {
  PLANNED
  IN_PROGRESS
  PARTIAL
  COMPLETED
  SKIPPED
  RESCHEDULED
}

enum TaskSkipReason {
  NO_TIME
  TOO_DIFFICULT
  ALREADY_KNEW
  NOT_RELEVANT
  OTHER
}

enum StudentProjectStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum ProjectMilestoneProgressStatus {
  PLANNED
  SUBMITTED
  COMPLETED
}

enum WeeklyDifficulty {
  TOO_EASY
  GOOD
  TOO_DIFFICULT
}

enum ExamPeriodType {
  INTERNAL_EXAM
  SEMESTER_EXAM
  VACATION
  PLACEMENT_WEEK
}

enum ExamPeriodProvenance {
  STUDENT
  UNIVERSITY_TEMPLATE
  COLLEGE_TEMPLATE
}

enum RevisionKind {
  WEEKLY
  MATERIAL
  ROLE
  CONTENT
  EXAM
}

enum AiUseCase {
  ROADMAP_EXPLANATION
  WEEKLY_COACHING
}

enum AiExplanationSource {
  GENERATED
  FALLBACK
}

enum NotificationType {
  TODAY_PLAN
  MISSED_PLAN
  WEEKLY_REVIEW
  UPCOMING_EXAM
  MILESTONE
  PLACEMENT_CHECKPOINT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationIntentStatus {
  READY
  SUPPRESSED
  EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  SUPPRESSED
  FAILED
}

model User {
  id                      String                       @id @db.Uuid
  email                   String                       @unique @db.VarChar(320)
  normalizedEmail         String                       @unique @map("normalized_email") @db.VarChar(320)
  displayName             String?                      @map("display_name") @db.VarChar(120)
  avatarUrl               String?                      @map("avatar_url") @db.VarChar(2048)
  status                  UserStatus                   @default(ACTIVE)
  locale                  String                       @default("en-IN") @db.VarChar(16)
  timezone                String                       @default("Asia/Kolkata") @db.VarChar(64)
  lastLoginAt             DateTime?                    @map("last_login_at") @db.Timestamptz(3)
  deletedAt               DateTime?                    @map("deleted_at") @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  lockVersion             Int                          @default(1) @map("lock_version")
  authAccounts            AuthAccount[]
  sessions                Session[]
  studentProfile          StudentProfile?
  adminMembership         AdminMembership?
  careerGoals             CareerGoal[]
  skillAssessments        SkillAssessment[]
  skillEvidence           SkillEvidence[]
  studentSkills           StudentSkill[]
  studyAvailability       StudyAvailability[]
  gapAnalyses             GapAnalysis[]
  roadmaps                Roadmap[]
  generationJobs          GenerationJob[]
  planningWeeks           PlanningWeek[]
  roadmapTasks            RoadmapTask[]
  taskOccurrences         TaskOccurrence[]
  taskCommands            TaskCommandRecord[]
  taskCompletions         TaskCompletion[]
  studentProjects         StudentProject[]
  projectMilestoneReviews ProjectMilestoneProgress[]   @relation("ProjectMilestoneReviewer")
  placementMetrics        PlacementMetric[]
  progressSnapshots       ProgressSnapshot[]
  weeklyReviews           WeeklyReview[]
  examPeriods             ExamPeriod[]
  revisionDiffs           RoadmapRevisionDiff[]
  placementProfile        PlacementProfile?
  communicationPreference CommunicationPreference?
  notificationPreferences NotificationTypePreference[]
  notifications           NotificationIntent[]
  aiExplanations          AiExplanationCache[]
  aiRequestAudits         AiRequestAudit[]
  pilotFeedback           PilotFeedback[]

  @@index([status, deletedAt])
  @@map("users")
}

model CareerDataset {
  id               String                 @id @db.Uuid
  datasetVersion   String                 @unique @map("dataset_version") @db.VarChar(32)
  status           ContentStatus          @default(DRAFT)
  synthetic        Boolean                @default(false)
  editorId         String                 @map("editor_id") @db.Uuid
  reviewerId       String?                @map("reviewer_id") @db.Uuid
  reviewRationale  String                 @map("review_rationale") @db.VarChar(2000)
  reviewedAt       DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  publishedAt      DateTime?              @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  skills           Skill[]
  domains          CareerDomain[]
  roles            CareerRoleVersion[]
  learningUnits    LearningUnitTemplate[]
  goals            CareerGoal[]
  imports          ContentImport[]
  gapAnalyses      GapAnalysis[]
  roadmapRevisions RoadmapRevision[]
  projectDatasets  ProjectDataset[]

  @@index([status, synthetic, publishedAt])
  @@map("career_datasets")
}

model Skill {
  id                       String                   @id @db.Uuid
  datasetId                String                   @map("dataset_id") @db.Uuid
  stableKey                String                   @map("stable_key") @db.VarChar(128)
  name                     String                   @db.VarChar(160)
  category                 SkillCategory
  rubricVersion            Int                      @map("rubric_version")
  evidenceDecayDays        Int?                     @map("evidence_decay_days")
  dataset                  CareerDataset            @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  prerequisites            SkillPrerequisite[]      @relation("SkillDependents")
  dependents               SkillPrerequisite[]      @relation("SkillPrerequisites")
  roleRequirements         RoleSkillRequirement[]
  learningUnitLinks        LearningUnitSkill[]
  assessmentResponses      AssessmentResponse[]
  evidence                 SkillEvidence[]
  studentEstimates         StudentSkill[]
  curriculumMappings       CurriculumSkillMapping[]
  gapItems                 GapAnalysisItem[]
  roadmapMilestones        RoadmapMilestone[]
  roadmapTasks             RoadmapTask[]
  projectPrerequisites     ProjectPrerequisite[]
  projectMilestoneOutcomes ProjectMilestoneSkill[]

  @@unique([datasetId, stableKey])
  @@index([category, stableKey])
  @@map("skills")
}

model SkillPrerequisite {
  skillId        String           @map("skill_id") @db.Uuid
  prerequisiteId String           @map("prerequisite_id") @db.Uuid
  type           PrerequisiteType
  threshold      Decimal          @db.Decimal(4, 3)
  skill          Skill            @relation("SkillPrerequisites", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite   Skill            @relation("SkillDependents", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteId])
  @@map("skill_prerequisites")
}

model CareerDomain {
  id        String              @id @db.Uuid
  datasetId String              @map("dataset_id") @db.Uuid
  stableKey String              @map("stable_key") @db.VarChar(128)
  name      String              @db.VarChar(160)
  dataset   CareerDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  roles     CareerRoleVersion[]

  @@unique([datasetId, stableKey])
  @@map("career_domains")
}

model CareerRoleVersion {
  id               String                 @id @db.Uuid
  datasetId        String                 @map("dataset_id") @db.Uuid
  domainId         String                 @map("domain_id") @db.Uuid
  stableKey        String                 @map("stable_key") @db.VarChar(128)
  name             String                 @db.VarChar(160)
  version          Int
  dataset          CareerDataset          @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  domain           CareerDomain           @relation(fields: [domainId], references: [id], onDelete: Restrict)
  requirements     RoleSkillRequirement[]
  goals            CareerGoal[]
  goalVersions     CareerGoalVersion[]
  projectRoleFits  ProjectRoleFit[]
  placementMetrics PlacementMetric[]

  @@unique([datasetId, stableKey, version])
  @@index([stableKey, version])
  @@map("career_role_versions")
}

model RoleSkillRequirement {
  id                           String             @id @db.Uuid
  roleVersionId                String             @map("role_version_id") @db.Uuid
  targetLevel                  TargetLevel        @map("target_level")
  skillId                      String             @map("skill_id") @db.Uuid
  requiredDepth                Decimal            @map("required_depth") @db.Decimal(4, 3)
  importance                   Decimal            @db.Decimal(4, 3)
  placementRelevance           Decimal            @map("placement_relevance") @db.Decimal(4, 3)
  required                     Boolean
  requiredByDaysBeforeDeadline Int                @map("required_by_days_before_deadline")
  hoursP25                     Decimal            @map("hours_p25") @db.Decimal(8, 2)
  hoursP50                     Decimal            @map("hours_p50") @db.Decimal(8, 2)
  hoursP75                     Decimal            @map("hours_p75") @db.Decimal(8, 2)
  rationale                    String             @db.VarChar(1000)
  roleVersion                  CareerRoleVersion  @relation(fields: [roleVersionId], references: [id], onDelete: Cascade)
  skill                        Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)
  gapItems                     GapAnalysisItem[]
  roadmapMilestones            RoadmapMilestone[]

  @@unique([roleVersionId, targetLevel, skillId])
  @@index([skillId, targetLevel])
  @@map("role_skill_requirements")
}

model LearningUnitTemplate {
  id                String              @id @db.Uuid
  datasetId         String              @map("dataset_id") @db.Uuid
  stableKey         String              @map("stable_key") @db.VarChar(128)
  type              LearningUnitType
  fromDepth         Decimal             @map("from_depth") @db.Decimal(4, 3)
  toDepth           Decimal             @map("to_depth") @db.Decimal(4, 3)
  estimatedMinutes  Int                 @map("estimated_minutes")
  difficulty        Difficulty
  splitPoints       Json                @map("split_points") @db.JsonB
  reasonCodes       Json                @map("reason_codes") @db.JsonB
  dataset           CareerDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  skills            LearningUnitSkill[]
  roadmapMilestones RoadmapMilestone[]

  @@unique([datasetId, stableKey])
  @@map("learning_unit_templates")
}

model LearningUnitSkill {
  learningUnitId String               @map("learning_unit_id") @db.Uuid
  skillId        String               @map("skill_id") @db.Uuid
  learningUnit   LearningUnitTemplate @relation(fields: [learningUnitId], references: [id], onDelete: Cascade)
  skill          Skill                @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([learningUnitId, skillId])
  @@map("learning_unit_skills")
}

model CareerGoal {
  id               String              @id @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  datasetId        String              @map("dataset_id") @db.Uuid
  roleVersionId    String              @map("role_version_id") @db.Uuid
  targetLevel      TargetLevel         @map("target_level")
  deadline         DateTime            @db.Date
  deadlineBasis    String              @map("deadline_basis") @db.VarChar(64)
  status           CareerGoalStatus    @default(ACTIVE)
  lockVersion      Int                 @default(1) @map("lock_version")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset          CareerDataset       @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  roleVersion      CareerRoleVersion   @relation(fields: [roleVersionId], references: [id], onDelete: Restrict)
  versions         CareerGoalVersion[]
  assessments      SkillAssessment[]
  gapAnalyses      GapAnalysis[]
  roadmaps         Roadmap[]
  placementMetrics PlacementMetric[]

  @@index([userId, status])
  @@map("career_goals")
}

model SkillAssessment {
  id            String               @id @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  goalId        String               @map("goal_id") @db.Uuid
  schemaVersion String               @map("schema_version") @db.VarChar(32)
  status        AssessmentStatus     @default(OPEN)
  startedAt     DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt   DateTime?            @map("submitted_at") @db.Timestamptz(3)
  scoredAt      DateTime?            @map("scored_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          CareerGoal           @relation(fields: [goalId], references: [id], onDelete: Restrict)
  responses     AssessmentResponse[]
  gapAnalyses   GapAnalysis[]

  @@index([userId, status])
  @@map("skill_assessments")
}

model AssessmentResponse {
  id              String          @id @db.Uuid
  assessmentId    String          @map("assessment_id") @db.Uuid
  skillId         String          @map("skill_id") @db.Uuid
  rawLevel        String          @map("raw_level") @db.VarChar(32)
  normalizedValue Decimal?        @map("normalized_value") @db.Decimal(4, 3)
  confidence      Decimal         @db.Decimal(4, 3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  assessment      SkillAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skill           Skill           @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, skillId])
  @@map("assessment_responses")
}

model SkillEvidence {
  id          String         @id @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  skillId     String         @map("skill_id") @db.Uuid
  sourceType  EvidenceSource @map("source_type")
  sourceId    String         @map("source_id") @db.VarChar(128)
  proficiency Decimal        @db.Decimal(4, 3)
  confidence  Decimal        @db.Decimal(4, 3)
  occurredAt  DateTime       @map("occurred_at") @db.Timestamptz(3)
  expiresAt   DateTime?      @map("expires_at") @db.Timestamptz(3)
  metadata    Json           @default("{}") @db.JsonB
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, skillId])
  @@index([userId, skillId, occurredAt])
  @@map("skill_evidence")
}

model StudentSkill {
  id                   String    @id @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  skillId              String    @map("skill_id") @db.Uuid
  proficiency          Decimal?  @db.Decimal(4, 3)
  confidence           Decimal   @default(0) @db.Decimal(4, 3)
  effectiveProficiency Decimal?  @map("effective_proficiency") @db.Decimal(4, 3)
  algorithmVersion     String    @map("algorithm_version") @db.VarChar(32)
  lastEvidencedAt      DateTime? @map("last_evidenced_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill                Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@map("student_skills")
}

model CurriculumSkillMapping {
  id                String          @id @db.Uuid
  curriculumTopicId String          @map("curriculum_topic_id") @db.Uuid
  skillId           String          @map("skill_id") @db.Uuid
  breadth           Decimal         @db.Decimal(4, 3)
  depth             Decimal         @db.Decimal(4, 3)
  confidence        Decimal         @db.Decimal(4, 3)
  practiceRequired  Boolean         @map("practice_required")
  evidencePotential Decimal         @map("evidence_potential") @db.Decimal(4, 3)
  rationale         String          @db.VarChar(1000)
  version           Int
  reviewerId        String          @map("reviewer_id") @db.Uuid
  publishedAt       DateTime        @map("published_at") @db.Timestamptz(3)
  curriculumTopic   CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Restrict)
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([curriculumTopicId, skillId, version])
  @@index([skillId, confidence])
  @@map("curriculum_skill_mappings")
}

model StudyAvailability {
  id                String            @id @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  timezone          String            @db.VarChar(64)
  weeklyMinutes     Int               @map("weekly_minutes")
  maxSessionMinutes Int               @map("max_session_minutes")
  dayWindows        Json              @map("day_windows") @db.JsonB
  effectiveFrom     DateTime          @map("effective_from") @db.Date
  effectiveTo       DateTime?         @map("effective_to") @db.Date
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapRevisions  RoadmapRevision[]
  gapAnalyses       GapAnalysis[]
  planningWeeks     PlanningWeek[]

  @@unique([userId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@map("study_availability")
}

model GapAnalysis {
  id                  String            @id @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  goalId              String            @map("goal_id") @db.Uuid
  curriculumProgramId String            @map("curriculum_program_id") @db.Uuid
  careerDatasetId     String            @map("career_dataset_id") @db.Uuid
  assessmentId        String?           @map("assessment_id") @db.Uuid
  availabilityId      String            @map("availability_id") @db.Uuid
  rulesetVersion      String            @map("ruleset_version") @db.VarChar(32)
  inputHash           String            @map("input_hash") @db.Char(64)
  status              GapAnalysisStatus
  currentContribution Decimal           @map("current_contribution") @db.Decimal(5, 2)
  collegeContribution Decimal           @map("college_contribution") @db.Decimal(5, 2)
  independentGap      Decimal           @map("independent_gap") @db.Decimal(5, 2)
  effortP25Hours      Decimal           @map("effort_p25_hours") @db.Decimal(9, 2)
  effortP50Hours      Decimal           @map("effort_p50_hours") @db.Decimal(9, 2)
  effortP75Hours      Decimal           @map("effort_p75_hours") @db.Decimal(9, 2)
  allocatableMinutes  Int               @map("allocatable_minutes")
  requiredMinutes     Int               @map("required_minutes")
  deficitMinutes      Int               @map("deficit_minutes")
  warnings            Json              @default("[]") @db.JsonB
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                CareerGoal        @relation(fields: [goalId], references: [id], onDelete: Restrict)
  curriculumProgram   CurriculumProgram @relation(fields: [curriculumProgramId], references: [id], onDelete: Restrict)
  careerDataset       CareerDataset     @relation(fields: [careerDatasetId], references: [id], onDelete: Restrict)
  assessment          SkillAssessment?  @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  availability        StudyAvailability @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  items               GapAnalysisItem[]
  roadmapRevisions    RoadmapRevision[]
  generationJobs      GenerationJob[]

  @@unique([userId, inputHash])
  @@index([userId, createdAt])
  @@map("gap_analyses")
}

model GapAnalysisItem {
  id                   String               @id @db.Uuid
  analysisId           String               @map("analysis_id") @db.Uuid
  requirementId        String               @map("requirement_id") @db.Uuid
  skillId              String               @map("skill_id") @db.Uuid
  classification       GapClassification
  currentProficiency   Decimal?             @map("current_proficiency") @db.Decimal(4, 3)
  evidenceConfidence   Decimal              @map("evidence_confidence") @db.Decimal(4, 3)
  effectiveProficiency Decimal?             @map("effective_proficiency") @db.Decimal(4, 3)
  curriculumDepth      Decimal              @map("curriculum_depth") @db.Decimal(4, 3)
  mappingConfidence    Decimal              @map("mapping_confidence") @db.Decimal(4, 3)
  currentRatio         Decimal              @map("current_ratio") @db.Decimal(5, 4)
  collegeRatio         Decimal              @map("college_ratio") @db.Decimal(5, 4)
  externalRatio        Decimal              @map("external_ratio") @db.Decimal(5, 4)
  effortP25Hours       Decimal              @map("effort_p25_hours") @db.Decimal(9, 2)
  effortP50Hours       Decimal              @map("effort_p50_hours") @db.Decimal(9, 2)
  effortP75Hours       Decimal              @map("effort_p75_hours") @db.Decimal(9, 2)
  reasonCodes          Json                 @map("reason_codes") @db.JsonB
  trace                Json                 @db.JsonB
  analysis             GapAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  requirement          RoleSkillRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  skill                Skill                @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([analysisId, requirementId])
  @@map("gap_analysis_items")
}

model Roadmap {
  id               String                 @id @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  goalId           String                 @map("goal_id") @db.Uuid
  status           RoadmapLifecycleStatus @default(ACTIVE)
  activeRevisionId String?                @unique @map("active_revision_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             CareerGoal             @relation(fields: [goalId], references: [id], onDelete: Restrict)
  activeRevision   RoadmapRevision?       @relation("ActiveRoadmapRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  revisions        RoadmapRevision[]      @relation("RoadmapRevisions")
  generationJobs   GenerationJob[]

  @@unique([goalId])
  @@index([userId, status])
  @@map("roadmaps")
}

model RoadmapRevision {
